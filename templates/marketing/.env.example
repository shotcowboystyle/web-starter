# Build adapter for on-demand rendering: vercel, netlify, cloudflare, node
# Default: node
ADAPTER=node

# Site URL (sitemap generation, canonical URLs)
SITE_URL=http://localhost:4321

# Analytics
# Set to true to bypass cookie consent and always load analytics
ANALYTICS_ALWAYS_LOAD=false

# Google Analytics
GA_ID=
GA_ENABLED=false

# Rybbit Analytics
RYBBIT_ID=
RYBBIT_SRC=https://rybbit.example.com/api/script.js
RYBBIT_ENABLED=false

# Umami Analytics
UMAMI_ID=
UMAMI_SRC=https://analytics.umami.is/script.js
UMAMI_ENABLED=false
